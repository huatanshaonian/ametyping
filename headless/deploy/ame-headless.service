# systemd user unit: AmeTyping headless service (Linux). @NODE@ / @ROOT@ are filled in on install:
#   sed "s#@NODE@#$(command -v node)#; s#@ROOT@#$HOME/ametyping#" ame-headless.service > ~/.config/systemd/user/ame-headless.service
#   systemctl --user daemon-reload && systemctl --user enable --now ame-headless
#   sudo loginctl enable-linger $USER      # keep running without a login session
[Unit]
Description=AmeTyping headless service (hooks + control API on 127.0.0.1:3940)

[Service]
# restarting the service stops only its own node process: tmux and the Claude sessions in it stay (the default,
# control-group, killed every process the service ever started -- a tmux server started from the dashboard and all
# the sessions in it -- on each update). launch.js also starts tmux in a scope of its own, outside this service.
KillMode=process
ExecStart=@NODE@ @ROOT@/headless/ame-headless.js
Restart=on-failure
RestartSec=3
# tmux and claude are looked up on PATH
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
